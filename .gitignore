__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
.ipynb_checkpoints/

# Large and regenerable TESS products.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Reports may retain curated figures only.
reports/figures/*
!reports/figures/.gitkeep
